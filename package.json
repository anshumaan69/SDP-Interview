{
  "name": "sdp-interview",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Preparation Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"@sdp/shared\" build && pnpm --filter \"@sdp/api\" build && pnpm --filter \"@sdp/web\" build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter \"@sdp/api\" db:generate",
    "db:push": "pnpm --filter \"@sdp/api\" db:push",
    "db:seed": "pnpm --filter \"@sdp/api\" db:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@12.21.0"
}
