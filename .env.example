# Global / Docker environment configuration
NODE_ENV=development

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sdp_interview
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/sdp_interview?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_URL="redis://localhost:6385"

# Apps ports
PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
WEB_PORT=3000

# Auth
JWT_ACCESS_SECRET=sdp_super_secret_access_jwt_key_2026_dev
JWT_REFRESH_SECRET=sdp_super_secret_refresh_jwt_key_2026_dev

# LLM & Email
LLM_PROVIDER=mock
GEMINI_API_KEY=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="noreply@ai-interview-prep.com"
